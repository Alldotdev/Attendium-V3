# Attendium Environment Configuration Template
# Copy this file to .env for local development

# AI Provider API Keys (Optional - user can also configure via UI Settings)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth Client Configuration (Desktop OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local Environment
APP_ENV=development
DEBUG_LOGGING=false
